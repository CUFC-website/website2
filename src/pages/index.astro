---
const title = 'My Astro Website';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A starter Astro website hosted on Apache." />
    <title>{title}</title>
  </head>
  <body>
    <main class="container">
      <section class="hero">
        <p class="eyebrow">Astro + Apache</p>
        <h1>{title}</h1>
        <p class="intro">
          A fast static website starter. Build it with Astro, then serve the generated files with Apache.
        </p>
        <nav>
          <a href="/about/">About</a>
        </nav>
      </section>
    </main>
  </body>
</html>

<style>
  :root {
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: #111827;
    background: #f3f4f6;
  }

  body {
    margin: 0;
    min-height: 100vh;
  }

  .container {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 2rem;
  }

  .hero {
    width: min(760px, 100%);
    padding: 3rem;
    background: #ffffff;
    border-radius: 24px;
    box-shadow: 0 24px 80px rgb(15 23 42 / 0.08);
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #2563eb;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 8vw, 5rem);
    line-height: 1;
  }

  .intro {
    max-width: 58ch;
    margin: 1.25rem 0 2rem;
    color: #4b5563;
    font-size: 1.125rem;
    line-height: 1.7;
  }

  a {
    display: inline-block;
    padding: 0.8rem 1rem;
    border-radius: 999px;
    background: #111827;
    color: #ffffff;
    text-decoration: none;
    font-weight: 700;
  }
</style>
